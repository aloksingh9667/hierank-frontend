# Public URL of the Express API (used in the browser for forms + admin)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Optional: internal API URL for server-side rendering (e.g. inside Docker). Falls back to NEXT_PUBLIC_API_URL
API_URL=http://localhost:5000/api
# Public URL of this site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
